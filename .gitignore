# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / wrangler
.wrangler
.dev.vars

# screenshots taken while checking pages in a browser
/.playwright-mcp/
/*.png

# Локальные настройки Claude Code: разрешения этой машины, не команды.
.claude/settings.local.json

# Копии базы (scripts/firestore-backup.mjs). В них адреса людей и то, что
# они о себе написали, — такому место там, где лежит сама база, а не в
# репозитории.
/backup/

# Отчёты Lighthouse (Т-01): их смотрят и выбрасывают.
/lighthouse/
