rules_version = '2';

// Who may upload and read the trip photos.
//
// Reads are open because these files are the pictures on the public pages.
// Uploads are the owner's alone, and the owner is defined the same way as in
// firestore.rules: an entry under /owners, not merely a signed-in account.
//
// Deploy with `firebase deploy --only storage`, or paste into
// Firebase console → Storage → Rules → Publish.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && firestore.exists(
             /databases/(default)/documents/owners/$(request.auth.uid)
           );
    }

    // Reference photographs attached to an idea from the public form.
    //
    // ТЗ v4 §3.2 said links, never uploads; the client changed that on
    // 24.11.2026 — people were sending ideas with nothing to look at because
    // their photographs were on their phone, not on the web. Nobody is signed
    // in on that page and nobody can be: the form is open to strangers by
    // design. So this rule gives away the one verb it has to — create — and
    // nothing else. No overwrite, no delete, no listing: a stranger can put a
    // picture here and can never come back for it or find anybody else's,
    // which is what stops the bucket becoming free file hosting.
    //
    // The browser compresses to 1920px before it uploads, which lands well
    // under a megabyte. A file over the cap is therefore not a large
    // photograph but something that did not come through the form.
    match /suggestions/{month}/{file} {
      allow read: if true;
      allow create: if request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read: if true;

      // The admin panel compresses and resizes before uploading, so a file
      // over 10 MB means something went wrong rather than a large photo, and
      // the content type keeps the bucket from becoming general file storage.
      allow create, update: if isOwner()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // `request.resource` does not exist on a delete, so this is its own rule
      // rather than part of the one above.
      allow delete: if isOwner();
    }
  }
}
