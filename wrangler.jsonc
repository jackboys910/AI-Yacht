{
  "$schema": "node_modules/wrangler/config-schema.json",

  // The Worker name also determines the default workers.dev subdomain:
  //   https://ai-yacht.<your-subdomain>.workers.dev
  "name": "ai-yacht",
  "compatibility_date": "2026-09-18",

  // The Worker exists for the handful of things a page cannot do for itself:
  // /api/rebuild, which lets the admin panel start a build without the owner
  // ever opening GitHub (А-08, А-09); /api/suggestion, which checks a
  // Turnstile token and writes to a collection no browser may write to
  // (ТЗ v4, §3); /api/subscribe, which keeps the mailing list browsers may
  // not read and sends the welcome letter; and /api/organizer-invite, which
  // emails an organizer the way into the panel (С-12) with a key no page may
  // carry. /api/videos is the one that holds no secret: YouTube's feed answers
  // Cloudflare and refuses the build runner, so the build asks the edge for it
  // instead of asking YouTube from GitHub. The site itself is still served as
  // files from the edge —
  // "run_worker_first" below lists the only paths that reach this code, so a
  // page view costs no invocation and the site is served exactly as before.
  "main": "src/worker/index.ts",

  "assets": {
    "directory": "./out",

    // `next build` with `trailingSlash: true` emits out/404.html, which
    // Cloudflare returns (with a 404 status) for unknown paths.
    "not_found_handling": "404-page",

    // Without this, a request that matches no file would be answered with the
    // 404 page instead of reaching the Worker.
    "run_worker_first": ["/api/*"]
  },

  // Plain values live here rather than in the dashboard, because a deploy
  // replaces whatever the dashboard holds. Values that must not be in the
  // repository are secrets instead, and secrets survive a deploy untouched:
  // `wrangler secret put NAME`, or the dashboard's Variables and Secrets page.
  // Those are GITHUB_TOKEN, FIREBASE_SERVICE_ACCOUNT, TURNSTILE_SECRET and
  // EMAILJS_PRIVATE_KEY — see DEPLOY.md §8a.
  //
  // Everything below is public by design. The EmailJS public key travels to
  // every visitor in the page bundle already; it names the account rather
  // than granting anything, and abuse is held off by the domain allow-list in
  // the EmailJS dashboard.
  "vars": {
    "GITHUB_REPO": "jackboys910/AI-Yacht",
    "FIREBASE_PROJECT_ID": "nazarov-net",
    "EMAILJS_SERVICE_ID": "default_service",
    "EMAILJS_TEMPLATE_ID": "template_epduqer",
    "EMAILJS_PUBLIC_KEY": "as4ih3rGW3abw98dk",
    "CONTACT_EMAIL": "support@ctmass.com"
  },

  "observability": {
    "enabled": true
  }
}
