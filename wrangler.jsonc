{
  "$schema": "node_modules/wrangler/config-schema.json",

  // The Worker name also determines the default workers.dev subdomain:
  //   https://ai-yacht.<your-subdomain>.workers.dev
  "name": "ai-yacht",
  "compatibility_date": "2026-09-18",

  // The Worker exists for one thing: /api/rebuild, which lets the admin panel
  // start a build without the owner ever opening GitHub (А-08, А-09). The site
  // itself is still served as files from the edge — "run_worker_first" below
  // lists the only paths that reach this code, so a page view costs no
  // invocation and the site is served exactly as before.
  "main": "src/worker/index.ts",

  "assets": {
    "directory": "./out",

    // `next build` with `trailingSlash: true` emits out/404.html, which
    // Cloudflare returns (with a 404 status) for unknown paths.
    "not_found_handling": "404-page",

    // Without this, a request that matches no file would be answered with the
    // 404 page instead of reaching the Worker.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  }
}
