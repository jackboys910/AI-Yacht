rules_version = '2';

// Who may read and write what in the nazarov.net database.
//
// The project's API key travels to every visitor's browser, so nothing here
// may rely on it being secret. Three groups exist:
//
//   - visitors and `next build`, signed in to nothing, who may read exactly
//     the content the site renders;
//   - the owner, whose account is listed under /owners;
//   - the Cloudflare Worker, which talks to Firestore through a service
//     account and bypasses these rules entirely — that is how subscriptions
//     and applications get written without opening the database to browsers.
//
// Deploy with `firebase deploy --only firestore:rules`, or paste this file
// into Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Being signed in is not being the owner. The Email/Password provider will
    // create an account for anyone who calls it directly with the public API
    // key, so authority comes from an /owners entry, which can only be added
    // by hand in the Firebase console.
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    /**
     * A signed-in account whose email address has actually been confirmed.
     *
     * The confirmation is the whole point. Anyone can register any address
     * with the public API key; only someone who can read that inbox can
     * confirm it. Without this test, naming an organizer by email would mean
     * handing the trip to whoever registered that address first.
     */
    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    /**
     * Whether this trip was opened to the signed-in account.
     *
     * Compared exactly rather than case-insensitively, and that is deliberate.
     * Firestore has to be able to prove a list query safe from the query
     * itself, and it cannot do that through a lower() call — the panel would
     * get a flat refusal for the whole query instead of the organizer's trips.
     * Both sides are lowercase already: Firebase lowercases the address in the
     * token, and the panel lowercases what the owner types.
     */
    function isOrganizerOf(trip) {
      return verified()
        && trip.organizerEmail is string
        && trip.organizerEmail == request.auth.token.email;
    }

    /**
     * What an organizer may not touch.
     *
     * A list of forbidden fields rather than a list of allowed ones, on
     * purpose: a field added to the model later is editable by default, which
     * is the harmless outcome, while the dangerous ones stay shut without
     * anybody having to remember to re-close them.
     *
     *  - status, statusBeforeArchive: publishing is the owner's decision.
     *  - startDate, endDate: moving a trip is not editing it. С-11 of ТЗ v4
     *    names rescheduling alongside publishing, and for the same reason —
     *    people have booked flights around those two dates.
     *  - organizerEmail: otherwise the first organizer could hand the trip on
     *    to anyone, including out of the owner's sight.
     *  - interestId, slug: both change the published address.
     *  - createdAt, publishedAt, suggestionId, organizerInvitedAt: the record
     *    of what happened and where the trip came from.
     *  - announcementSentAt: clearing it would let the announcement go out to
     *    every subscriber a second time.
     */
    function organizerKeepsOut() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status',
        'statusBeforeArchive',
        'startDate',
        'endDate',
        'organizerEmail',
        'interestId',
        'slug',
        'createdAt',
        'publishedAt',
        'suggestionId',
        'organizerInvitedAt',
        'announcementSentAt'
      ]);
    }

    // A person may check their own entry — the admin panel uses that to say
    // "this account is not the owner" instead of showing a panel where every
    // action silently fails. Nobody may list the collection or write to it.
    match /owners/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    /* ---------------------------------------------------------------------
       Content the site renders. Anonymous reads here are what `next build`
       uses to print the pages.
       --------------------------------------------------------------------- */

    match /interests/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /people/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Live Going / Interested numbers, refreshed in the browser between builds
    // (§6.3). Visitors read them; the Worker is what increments them.
    match /counters/{tripId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // П-09: drafts and archived trips are invisible to visitors anywhere on
    // the site. The published test comes first so that reading a public trip
    // costs no extra document lookup.
    //
    // ТЗ v4 §2.3 adds a third reader: the organizer of a trip sees it before
    // anyone else does, because that is the point of handing them the panel —
    // a trip they can only see once it is live is a trip they cannot prepare.
    match /trips/{id} {
      allow read: if resource.data.status == 'published'
        || isOwner()
        || isOrganizerOf(resource.data);

      // Creating and deleting stay the owner's: an organizer edits the trip
      // they were given, they do not start or end one.
      allow create, delete: if isOwner();

      allow update: if isOwner()
        || (isOrganizerOf(resource.data) && organizerKeepsOut());
    }

    /* ---------------------------------------------------------------------
       Personal data. Written by the Worker, read by the owner, never exposed
       to a browser: one line in a console would otherwise walk off with the
       whole subscriber list.
       --------------------------------------------------------------------- */

    match /subscribers/{id} {
      allow read, write: if isOwner();
    }

    match /interested/{id} {
      allow read, write: if isOwner();
    }

    /**
     * Who applied to go (ТЗ v4, §12).
     *
     * The organizer reads the applications to their own trip and nobody
     * else's. Which trip that is comes from `organizerEmail` written on the
     * application itself, not from fetching the trip, and the difference is
     * not style: a query may make only twenty document lookups in total, so
     * the fetching version would have worked in testing and then refused the
     * whole list on the first trip with twenty-one applicants.
     *
     * `get` keeps the fetching version as well, for the one case the copy
     * cannot cover — an application that arrived before the owner named an
     * organizer. A single document read may make ten lookups, and this is
     * one.
     *
     * Writing stays with the owner: a decision on an application is his, and
     * the applications themselves are written by the Worker through a service
     * account, which these rules do not apply to.
     */
    match /applications/{id} {
      allow get: if isOwner()
        || isOrganizerOf(resource.data)
        || isOrganizerOf(
             get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data
           );
      allow list: if isOwner() || isOrganizerOf(resource.data);
      allow write: if isOwner();
    }

    // Ideas sent through Suggest an Adventure (ТЗ v4, §3). Written by the
    // Worker through a service account, which bypasses these rules, so no
    // browser needs any access at all — and this is the collection where
    // opening one up would hurt most: it holds email addresses and what
    // people wrote about themselves to be allowed on a trip.
    match /adventureSuggestions/{id} {
      allow read, write: if isOwner();
    }

    match /solutionsInquiries/{id} {
      allow read, write: if isOwner();
    }

    // Anything added later starts closed rather than open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
